# ==============================================================================
# HPLMN Testbed — Environment Template
# Copy this file to .env and fill in your IP addresses:
#   cp lib/setup/.env.template .env
# Then run: ./lib/setup/configure_ip_from_env.sh
# .env is gitignored — never commit it directly.
# ==============================================================================

# ── IP Addresses (required) ──
HPLMN_IP=          # This machine (PC2) IP address
VPLMN_IP=          # Remote machine (PC1) IP address

# ── NF config files (set by set-open5gs-mode.sh) ──
NRF_CONFIG=nrf.yaml
SCP_CONFIG=scp.yaml
AMF_CONFIG=amf.yaml
SMF_CONFIG=smf.yaml
UPF_CONFIG=upf.yaml
AUSF_CONFIG=ausf.yaml
UDM_CONFIG=udm.yaml
PCF_CONFIG=pcf.yaml
NSSF_CONFIG=nssf.yaml
BSF_CONFIG=bsf.yaml
UDR_CONFIG=udr.yaml
SEPP_CONFIG=sepp.yaml

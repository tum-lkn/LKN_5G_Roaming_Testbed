# ============================================================================
# Shared settings for docker-compose.yml AND ike_eval_docker.sh
# ============================================================================

# Container network — intentionally DIFFERENT from the VM lab network
# (10.162.149.0/24), so the containers never collide with the real testbed
# even when this runs on one of the lab VMs.
# Change these four values if 192.168.40.0/24 happens to exist on your host
# (check: ip a | grep 192.168.40 ; docker network inspect $(docker network ls -q) | grep 192.168.40).
SUBNET=192.168.40.0/24
GW_IP=192.168.40.1
PC1_IP=192.168.40.55
PC2_IP=192.168.40.230

# strongSwan source to build:
#   ml-dsa  -> upstream ml-dsa branch: ML-KEM + ML-DSA  (all 4 scenarios)
#   6.0.4   -> release tag: ML-KEM only                 (scenarios 1+2)
SWAN_REF=ml-dsa

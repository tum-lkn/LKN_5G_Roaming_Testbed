# Backup and log files — never commit, anywhere in this testbed
*.bak
*.bak.*
*.log

# Python
*.pyc
*.pyo
*.pyd
__pycache__/

# Python virtual environment
venv/
webui/backend/venv/

# Logs and results
logs/
# Setup run logs — machine-local: contain absolute $HOME paths, IPs and SSH
# key fingerprints. Regenerated by lib/setup/setup.sh on every run.
setup_logs/
results/
results2/
results3/
configs/interface_delay_investigation/
webui/logs/
webui/results/
browsertime-5g-results/

# automatically generated config files
configs/generated/

# Batch configs generated by the WebUI per run (timestamped) when it launches
# an automation/batch job — runtime artifacts, not committed.
configs/webui_run_*.conf

# Per-mode test configs — rebuilt by configs/generate_confs.sh, which setup.sh
# runs as a final step, so they are not committed. configs/main.conf is
# hand-maintained (batch parameter matrix) and stays tracked.
configs/non_roaming.conf
configs/lbo.conf
configs/hr.conf
configs/hr_ipsec_1.conf
configs/hr_ipsec_2.conf
configs/hr_ipsec_3.conf
configs/hr_ipsec_4.conf
configs/hr_ipsec_5.conf
configs/hr_ipsec_6.conf

# Per-iteration PacketRusher UE configs (config_1..100.yml per mode) — rebuilt by
# configs/Packetrusher_Configs/generate_Packetrusher_configs.sh, which setup.sh
# runs as a final step. The base config_<mode>_roaming.yml files they are
# expanded from stay tracked.
configs/Packetrusher_Configs/hr_roaming/
configs/Packetrusher_Configs/lbo_roaming/
configs/Packetrusher_Configs/non_roaming/

# OS files
.DS_Store
*.swp

# PacketRusher binary dir — cloned separately, not part of this repo
PacketRusher/

# Machine-local environment — contains real IPs, never commit
# Copy lib/setup/.env.template to .env and fill in your IPs
.env

# Generated Plots tab cache (WebUI) — regenerated on demand
webui/backend/plots_cache/

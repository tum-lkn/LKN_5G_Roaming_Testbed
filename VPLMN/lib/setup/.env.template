# ==============================================================================
# VPLMN Testbed — Environment Template
# Copy this file to .env and fill in your IP addresses:
#   cp lib/setup/.env.template .env
# Then run: ./lib/setup/configure_ip_from_env.sh
# .env is gitignored — never commit it directly.
# ==============================================================================

# ── IP Addresses (required) ──
VPLMN_IP=          # This machine (PC1) IP address
HPLMN_IP=          # Remote machine (PC2) IP address

# ── SSH credentials ──
HPLMN_USER=        # SSH username on HPLMN (PC2)
VPLMN_USER=        # SSH username on VPLMN (PC1, this machine)

# ── Performance test server ──
PERF_SERVER_IP=    # IP address of the performance/iperf3 server
PERF_SERVER_USER=  # SSH username on the performance server

# ── UPF Docker image (set by set-open5gs-mode.sh) ──
UPF_IMAGE=open5gs-upf:v2.7.2

# ── NF config files (set by set-open5gs-mode.sh) ──
NRF_CONFIG=nrf.yaml
SCP_CONFIG=scp.yaml
AMF_CONFIG=amf.yaml
SMF_CONFIG=smf.yaml
UPF_CONFIG=upf.yaml
AUSF_CONFIG=ausf.yaml
UDM_CONFIG=udm.yaml
PCF_CONFIG=pcf.yaml
NSSF_CONFIG=nssf.yaml
BSF_CONFIG=bsf.yaml
UDR_CONFIG=udr.yaml
SEPP_CONFIG=sepp.yaml
